generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
  CANCELED
}

model Purchase {
  id                    String         @id @default(cuid())
  email                 String
  status                PurchaseStatus @default(PENDING)

  stripeSessionId       String         @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?

  discordInviteUrl      String?
  emailSentAt           DateTime?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([email])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  ipAddress String?
  country   String?
  region    String?
  city      String?
  source    String   @default("vsl")
  createdAt DateTime @default(now())
}

model Visit {
  id        String   @id @default(cuid())
  path      String
  ipAddress String?
  country   String?
  region    String?
  city      String?
  referrer  String?
  createdAt DateTime @default(now())
}
